# Inherit from a base style and customize
BasedOnStyle: LLVM
# Place braces on the same line as the control statement
BreakBeforeBraces: Attach
# Use 4 spaces for indentation (common in C#)
IndentWidth: 4
ContinuationIndentWidth: 4
# Indent case labels (optional, but a common C# style)
IndentCaseLabels: false
# Add a space after control statement keywords (e.g., if, for, while)
SpaceAfterControlKeyword: true
# Put spaces around operators (e.g., = + - *)
SpacesAroundOperators: true
# Do not space after C++ cast (C# doesn't have direct equivalent, but good C++ practice)
SpacesWithAngles: false
# Align parameters in function declarations
AlignAfterBracket: false
AlignOperands: false
# Ensure empty lines are not removed excessively
KeepEmptyLinesAtTheEndOfFile: true
# Language is C++
Language: Cpp
